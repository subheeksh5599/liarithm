# Every value is required. Nothing has a default: a missing value makes the
# server answer with a clear error instead of guessing.

# Signs the testimony log and seals each session. 32+ random characters.
SESSION_SECRET=

# The brain: SERV Reasoning (OpenAI-compatible endpoint).
SERV_BASE_URL=
SERV_API_KEY=
SERV_MODEL=

# The voice: Dolphin network (OpenAI-compatible endpoint).
DOLPHIN_BASE_URL=
DOLPHIN_API_KEY=
DOLPHIN_MODEL=

# Optional voice fallbacks, tried in order when Dolphin cannot answer.
# The provider that spoke is recorded on each signed line and shown under it.
VOICE_FALLBACK_1_NAME=
VOICE_FALLBACK_1_BASE_URL=
VOICE_FALLBACK_1_API_KEY=
VOICE_FALLBACK_1_MODEL=
VOICE_FALLBACK_2_NAME=
VOICE_FALLBACK_2_BASE_URL=
VOICE_FALLBACK_2_API_KEY=
VOICE_FALLBACK_2_MODEL=
