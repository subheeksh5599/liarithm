# Liarithm runs on your own keys. Nothing has a default value.

# Required. Signs the testimony log and seals each session. 32+ random characters.
SESSION_SECRET=

# Required. The brain: SERV Reasoning decides what every suspect may admit.
SERV_BASE_URL=https://inference-api.openserv.ai/v1
SERV_API_KEY=
SERV_MODEL=gpt-6-luna-serv-kronos-multipath

# Optional. Brain fallbacks (any OpenAI-compatible endpoint), used only when SERV cannot answer.
# The provider that decided each move is signed into the testimony log and shown in the game.
BRAIN_1_NAME=
BRAIN_1_BASE_URL=
BRAIN_1_API_KEY=
BRAIN_1_MODEL=

# Optional. The voice: who speaks the lines SERV has decided.
# Leave every voice empty and SERV phrases the lines itself.
# Providers are tried in order: Dolphin first (if its key is set), then VOICE_1 ... VOICE_5.
# The provider that spoke each line is signed into the testimony log and shown under the line.
DOLPHIN_BASE_URL=https://lighthouse.dphn.ai/run/text-v/v1
DOLPHIN_API_KEY=
DOLPHIN_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# Any OpenAI-compatible endpoint, e.g. Groq or OpenRouter.
VOICE_1_NAME=
VOICE_1_BASE_URL=
VOICE_1_API_KEY=
VOICE_1_MODEL=
